{
	# Replace with your domain for production HTTPS
	# localhost {
	# 	tls internal
	# }

	:80 {
		handle /api/* {
			reverse_proxy tinyvoice-api:8080
		}

		handle /health {
			reverse_proxy tinyvoice-api:8080
		}

		handle /evolution/* {
			uri strip_prefix /evolution
			reverse_proxy evolution:8080
		}

		handle {
			respond "TinyVoice API" 200
		}
	}
}

# Production example (uncomment and set domain):
