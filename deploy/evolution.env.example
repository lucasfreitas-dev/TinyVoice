# Evolution API environment (reference — main config is in docker-compose.yml)
SERVER_URL=http://localhost
AUTHENTICATION_API_KEY=change-me-evolution-key
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgres://tinyvoice:change-me-postgres@postgres:5432/evolution?sslmode=disable
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379
