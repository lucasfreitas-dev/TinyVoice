# PostgreSQL
POSTGRES_USER=tinyvoice
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=tinyvoice
DATABASE_URL=postgres://tinyvoice:change-me-postgres@postgres:5432/tinyvoice?sslmode=disable

# MinIO
MINIO_ROOT_USER=tinyvoice
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=tinyvoice
MINIO_SECRET_KEY=change-me-minio
MINIO_BUCKET=tinyvoice-audio
MINIO_USE_SSL=false

# TinyVoice API
TINYVOICE_PUBLIC_URL=https://tinyvoice.example.com
ADMIN_TOKEN=change-me-admin-token
API_PORT=8080

# Evolution API (public base URL — Evolution manager lives at /manager on this host)
EVOLUTION_PUBLIC_URL=http://localhost
EVOLUTION_BASE_URL=http://evolution:8080
EVOLUTION_API_KEY=change-me-evolution-key
EVOLUTION_INSTANCE=tinyvoice
EVOLUTION_WEBHOOK_SECRET=change-me-webhook-secret

# Worker
WORKER_POLL_INTERVAL=5s
WORKER_MAX_ATTEMPTS=5
